# URL do backend em produção (deixe vazio em desenvolvimento: o Vite encaminha /api para http://127.0.0.1:8000)
VITE_API_URL=

# --- Contas e projetos na nuvem (Firebase) — OPCIONAL ---
# Valores públicos do app Web (Console do Firebase > Configurações do projeto > Seus apps).
# Sem estas variáveis o Simplexnator funciona normalmente, apenas sem contas.
# Nunca coloque chaves privadas ou credenciais administrativas aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
