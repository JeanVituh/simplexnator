    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "plotly.js-dist-min": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
