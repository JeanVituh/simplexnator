[{"id": "radioterapico", "title": "Problema Radioterápico", "category": "Radioterapia", "description": "Planejamento de radioterapia com dois feixes: minimiza a dose absorvida pelo tecido saudável, respeitando o limite nos tecidos críticos e as doses exigidas no tumor.", "highlights": ["Minimização", "Restrições ≤, = e ≥", "Solução inteira"], "context": {"statement": "Dois feixes de radiação são aplicados ao paciente. As variáveis x₁ e x₂ são as doses (em kilorads) de cada feixe. Os coeficientes indicam a dose absorvida por cada região do corpo por unidade de dose de cada feixe.", "objective": "Minimizar a dose total no tecido saudável: Z = 0,4x₁ + 0,5x₂.", "constraints": ["Tecidos críticos: 0,3x₁ + 0,1x₂ ≤ 2,7", "Região do tumor: 0,5x₁ + 0,5x₂ = 6", "Centro do tumor: 0,6x₁ + 0,4x₂ ≥ 6"]}, "problem": {"name": "Problema Radioterápico", "sense": "min", "objective": [0.4, 0.5], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "Tecidos críticos", "coefficients": [0.3, 0.1], "relation": "<=", "rhs": 2.7}, {"name": "Região do tumor", "coefficients": [0.5, 0.5], "relation": "=", "rhs": 6}, {"name": "Centro do tumor", "coefficients": [0.6, 0.4], "relation": ">=", "rhs": 6}]}}, {"id": "producao-inteira", "title": "Produção com solução inteira diferente do arredondamento", "category": "Programação inteira", "description": "Maximiza o lucro de dois produtos. O ótimo contínuo é fracionário e o Branch and Bound encontra um inteiro melhor que o obtido por piso e teto.", "highlights": ["Maximização", "Ótimo fracionário", "Branch and Bound"], "problem": {"name": "Produção com solução inteira", "sense": "max", "objective": [5, 4], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "Matéria-prima", "coefficients": [6, 4], "relation": "<=", "rhs": 24}, {"name": "Horas de máquina", "coefficients": [1, 2], "relation": "<=", "rhs": 6}]}}, {"id": "multipla", "title": "Soluções ótimas múltiplas", "category": "Soluções múltiplas", "description": "A curva de nível de Z é paralela à restrição x₁ + 2x₂ ≤ 8, formando uma aresta inteira de soluções ótimas.", "highlights": ["Maximização", "Curva de nível paralela", "Vértices alternativos"], "problem": {"name": "Soluções ótimas múltiplas", "sense": "max", "objective": [2, 4], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "R1", "coefficients": [1, 2], "relation": "<=", "rhs": 8}, {"name": "R2", "coefficients": [1, 0], "relation": "<=", "rhs": 6}, {"name": "R3", "coefficients": [0, 1], "relation": "<=", "rhs": 3}]}}, {"id": "mix3", "title": "Mix de produção com três variáveis", "category": "Modelagem", "description": "Maximiza o lucro de três produtos com três recursos limitados. Resolvido pelas tabelas Simplex; sem gráfico 2D.", "highlights": ["Maximização", "3 variáveis", "Somente restrições ≤"], "problem": {"name": "Mix de produção", "sense": "max", "objective": [3, 2, 5], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x3", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "R1", "coefficients": [1, 2, 1], "relation": "<=", "rhs": 430}, {"name": "R2", "coefficients": [3, 0, 2], "relation": "<=", "rhs": 460}, {"name": "R3", "coefficients": [1, 4, 0], "relation": "<=", "rhs": 420}]}}, {"id": "binario", "title": "Mochila binária", "category": "Programação inteira", "description": "Escolhe quais itens levar maximizando o valor dentro da capacidade. Todas as variáveis são binárias (0 ou 1).", "highlights": ["Maximização", "4 variáveis binárias", "Branch and Bound"], "problem": {"name": "Mochila binária", "sense": "max", "objective": [10, 13, 7, 8], "variables": [{"name": "x1", "kind": "binary", "lower": 0, "upper": 1}, {"name": "x2", "kind": "binary", "lower": 0, "upper": 1}, {"name": "x3", "kind": "binary", "lower": 0, "upper": 1}, {"name": "x4", "kind": "binary", "lower": 0, "upper": 1}], "constraints": [{"name": "Capacidade", "coefficients": [3, 4, 2, 3], "relation": "<=", "rhs": 7}]}}, {"id": "inviavel", "title": "Problema inviável", "category": "Casos especiais", "description": "As restrições x₁ + x₂ ≤ 2 e x₁ + x₂ ≥ 5 não podem ser satisfeitas ao mesmo tempo.", "highlights": ["Região viável vazia", "Detecção pelo Big-M e pelas Duas Fases"], "problem": {"name": "Problema inviável", "sense": "max", "objective": [1, 1], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "R1", "coefficients": [1, 1], "relation": "<=", "rhs": 2}, {"name": "R2", "coefficients": [1, 1], "relation": ">=", "rhs": 5}]}}, {"id": "ilimitado", "title": "Problema ilimitado", "category": "Casos especiais", "description": "Em x₁ − x₂ ≤ 1 a função Z = x₁ + x₂ cresce sem limite: nenhuma linha passa no teste da razão.", "highlights": ["Região viável aberta", "Teste da razão sem pivô"], "problem": {"name": "Problema ilimitado", "sense": "max", "objective": [1, 1], "variables": [{"name": "x1", "kind": "continuous", "lower": 0, "upper": null}, {"name": "x2", "kind": "continuous", "lower": 0, "upper": null}], "constraints": [{"name": "R1", "coefficients": [1, -1], "relation": "<=", "rhs": 1}]}}]